rules_version = '2';

// Toegang vereist een Microsoft-werkaccount (Firebase Auth, provider
// microsoft.com; de Azure-app is beperkt tot de tenant van Engine Energy).
// Deze regels bewaken verder vooral de VORM van de data en de
// statusovergangen. Volgende stap: per monteur afdichten (bijv. met een
// custom claim of een medewerkers-collectie).
//
// LET OP bij uitrollen: zet deze regels pas live als de app-versie met
// Microsoft-login bij de monteurs staat; oudere versies loggen anoniem in en
// krijgen dan geen toegang meer.

service cloud.firestore {
  match /databases/{database}/documents {

    function ingelogd() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com';
    }

    function bonPad(bonId) {
      return /databases/$(database)/documents/servicebonnen/$(bonId);
    }

    function bonStatus(bonId) {
      return exists(bonPad(bonId))
        ? get(bonPad(bonId)).data.get('status', 'open')
        : 'open';
    }

    // Collection-group query voor het weekoverzicht op het dashboard (alle
    // uren-regels van een monteur over alle bonnen). Alleen lezen.
    match /{pad=**}/regels/{regelId} {
      allow read: if ingelogd();
    }

    match /servicebonnen/{bonId} {
      allow read: if ingelogd();

      allow create, update: if ingelogd()
        && request.resource.data.keys().hasOnly([
             'jobOrderId', 'administratie', 'status', 'monteurIds',
             'bijgewerktOp', 'afrondenDoorId', 'afrondenDoorNaam',
             'afrondenGestartOp', 'afgerondOp'])
        && request.resource.data.get('status', 'open')
             in ['open', 'bezig_met_afronden', 'afgerond']
        // Een afgeronde bon gaat nooit meer open.
        && !(resource != null
             && resource.data.get('status', 'open') == 'afgerond'
             && request.resource.data.get('status', 'open') != 'afgerond');

      allow delete: if false;

      // Gedeelde pickstatus van de geplande onderdelen (één document).
      match /picking/{docId} {
        allow read: if ingelogd();
        allow create, update: if ingelogd()
          && docId == 'status'
          && request.resource.data.keys().hasOnly([
               'aantallen', 'gepakt', 'bevestigd', 'bijgewerktDoorId',
               'bijgewerktDoorNaam', 'bijgewerktOp'])
          && request.resource.data.get('aantallen', {}) is map
          && request.resource.data.get('gepakt', {}) is map
          && request.resource.data.get('bevestigd', false) is bool
          // Bevestigd blijft bevestigd.
          && !(resource != null
               && resource.data.get('bevestigd', false) == true
               && request.resource.data.get('bevestigd', false) != true);
        allow delete: if false;
      }

      match /regels/{regelId} {
        allow read: if ingelogd();

        function geldigeRegel() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'id', 'type', 'monteurId', 'monteurNaam',
                   'aangemaaktOp', 'bijgewerktOp', 'verwijderd', 'status',
                   'verstuurdOp', 'item', 'aantal', 'datum',
                   'workActivityId', 'workActivityCode', 'minuten', 'memo',
                   'km'])
            && d.id == regelId
            && d.type in ['artikel', 'uren', 'km']
            && d.monteurId is int
            && d.monteurNaam is string
            && d.verwijderd is bool
            && d.status in ['concept', 'verstuurd']
            && (d.type != 'artikel' || (d.item is map && d.aantal is int && d.aantal >= 0))
            && (d.type != 'uren' || (d.datum is string && d.minuten is int && d.minuten >= 0 && d.workActivityId is int))
            && (d.type != 'km' || (d.datum is string && d.km is int && d.km >= 0));
        }

        // Artikelen horen bij de bon en worden in één keer gepubliceerd door
        // wie afrondt. Uren en km zijn per monteur (Ridder boekt ze op de
        // eigen afspraak) en mogen ook na het afronden van de bon nog.
        function isArtikel(d) {
          return d.type == 'artikel';
        }

        // Nieuwe regels altijd als concept; artikelen alleen op een open bon.
        allow create: if ingelogd()
          && geldigeRegel()
          && request.resource.data.status == 'concept'
          && (!isArtikel(request.resource.data) || bonStatus(bonId) == 'open');

        allow update: if ingelogd()
          && geldigeRegel()
          && resource.data.status == 'concept'
          && request.resource.data.type == resource.data.type
          && request.resource.data.monteurId == resource.data.monteurId
          && (
            // Gewoon bewerken: uren/km altijd, artikelen zolang de bon open is.
            (request.resource.data.status == 'concept'
              && (!isArtikel(resource.data) || bonStatus(bonId) == 'open'))
            ||
            // Markeren als verstuurd na publicatie: uren/km altijd,
            // artikelen alleen tijdens het afronden.
            (request.resource.data.status == 'verstuurd'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'verstuurdOp', 'bijgewerktOp'])
              && (!isArtikel(resource.data)
                  || bonStatus(bonId) == 'bezig_met_afronden'))
          );

        // Verwijderen gaat via `verwijderd: true`, zodat iedereen het ziet.
        allow delete: if false;
      }
    }
  }
}
