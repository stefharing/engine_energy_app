# Kopieer naar tools/release.env en vul in. Dat bestand staat niet in git.

# App Store Connect API-sleutel (App Store Connect > Gebruikers en toegang >
# Integraties > Sleutels). Zet het gedownloade bestand hier neer:
#   ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
ASC_KEY_ID=
ASC_ISSUER_ID=

# Optioneel: numeriek Apple ID van de app (App Store Connect > App-informatie),
# nodig als altool de app niet vindt op bundle-id.
#ASC_APPLE_ID=

# Firebase App Distribution
FIREBASE_APP_ID=1:440259691759:ios:9aee67b2d6e1da239b071a
# Groepsnaam (alias) van de testers, bijv. "monteurs"
FIREBASE_GROUPS=
